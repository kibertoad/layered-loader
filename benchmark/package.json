{
  "name": "benchmark",
  "version": "1.0.0",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "benchmark:full": "pnpm --filter layered-loader run build && pnpm run docker:start && pnpm run db:migrate && pnpm run db:seed && pnpm run benchmark:run && pnpm run docker:stop",
    "benchmark:get:run": "node autocannon-layered-loader-get.js",
    "benchmark:get-many:run": "node autocannon-layered-loader-get-many.js",
    "docker:start": "docker-compose -f docker-compose.yml up --build -d",
    "docker:stop": "docker-compose -f docker-compose.yml down",
    "db:migrate": "node common/db/dbMigrate.js",
    "db:seed": "node common/db/dbSeed.js",
    "format": "prettier --write **/*.js autocannon-layered-loader-get.js"
  },
  "dependencies": {
    "async-cache-dedupe": "^3.4.0",
    "autocannon": "^8.0.0",
    "fastify": "^5.11.0",
    "ioredis": "^6.0.0",
    "knex": "^2.4.2",
    "knex-repositories": "^4.0.0",
    "knex-utils": "^6.0.0",
    "layered-loader": "workspace:^",
    "pg": "^8.22.0",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=22"
  }
}
